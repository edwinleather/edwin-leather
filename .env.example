# ------------------------------
# Shared / URLs
# ------------------------------
NODE_ENV=development
DEMO_MODE=true
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------
# MongoDB Atlas
# ------------------------------
MONGODB_URI=mongodb+srv://DEMO_USER:DEMO_PASSWORD@DEMO_CLUSTER.mongodb.net/edwin-leathers?retryWrites=true&w=majority

# ------------------------------
# Authentication
# ------------------------------
JWT_SECRET=DEMO_REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
COOKIE_NAME=edwin_session

# ------------------------------
# Razorpay
# ------------------------------
RAZORPAY_KEY_ID=rzp_test_DEMO_KEY_ID
RAZORPAY_KEY_SECRET=DEMO_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=DEMO_RAZORPAY_WEBHOOK_SECRET
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_DEMO_KEY_ID

# ------------------------------
# Cloudinary
# ------------------------------
CLOUDINARY_CLOUD_NAME=DEMO_CLOUD_NAME
CLOUDINARY_API_KEY=DEMO_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=DEMO_CLOUDINARY_API_SECRET

# ------------------------------
# Resend
# ------------------------------
EMAIL_API_KEY=re_DEMO_RESEND_KEY
EMAIL_FROM=Edwin Leathers <orders@example.com>

# ------------------------------
# Analytics / monitoring
# ------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-DEMO123456
NEXT_PUBLIC_SENTRY_DSN=https://DEMO_PUBLIC_KEY@DEMO_INGEST.sentry.io/DEMO_PROJECT
SENTRY_AUTH_TOKEN=DEMO_SENTRY_AUTH_TOKEN
