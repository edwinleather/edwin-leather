{
  "name": "@edwin/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:attributes": "tsx src/scripts/migrateAttributes.ts",
    "migrate:product-attributes": "tsx src/scripts/migrateProductAttributes.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "cookie-parser": "latest",
    "cors": "latest",
    "dotenv": "^17.4.2",
    "express": "latest",
    "express-rate-limit": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "mongoose": "latest",
    "nodemailer": "^9.1.1",
    "razorpay": "^2.9.8",
    "serverless-http": "^4.0.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cookie-parser": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "^6.4.17",
    "@vitest/spy": "^4.1.11",
    "cloudinary": "^2.11.0",
    "tsx": "latest",
    "typescript": "~5.9.0",
    "vitest": "^4.1.11"
  }
}
